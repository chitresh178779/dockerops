# ==========================================
# DockerOps Monorepo - Git Ignore Rules
# ==========================================

# Dependencies
node_modules/
.pnpm-store/
.pnpm-debug.log*

# Production & Build Outputs
dist/
build/
.next/
out/
.turbo/
apps/api/generated/
*.tsbuildinfo

# Environment & Secret Files (CRITICAL: Never commit secrets)
.env
.env.*
.env*.local
*.env
# Allow example templates
!.env.example
!.env.*.example

# Database, Runtime Dumps & Snapshots
*.sqlite
*.sqlite3
*.db
dump.rdb

# Private Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test Coverage
coverage/
.nyc_output/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE, Editor & Agent Directories
.claude/
.idea/
.vscode/
*.swp
*.swo
*~
