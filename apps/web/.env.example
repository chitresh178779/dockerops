# DockerOps Web Frontend Environment Variables
# Copy this file to .env.local for local development

# URL of the DockerOps NestJS API backend
NEXT_PUBLIC_API_URL=http://localhost:4000

# WebSocket URL for streaming live terminal PTY data
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Enable maintainer authoring tools in the UI (set to false for standard players)
NEXT_PUBLIC_SHOW_MAINTAINER_TOOLS=false
